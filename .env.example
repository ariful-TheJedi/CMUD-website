# =============================================================================
# Self-hosted MedLearHub / CMUD — copy to `.env` and edit
# Works with: npm run dev | npm start | PM2 (ecosystem.config.cjs)
# =============================================================================

# Local / VM Postgres (required)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/medlearhub"

# Better Auth (required for admin login)
BETTER_AUTH_SECRET="replace-with-a-long-random-string-32chars+"
# MUST match the exact URL you open in the browser (no trailing slash)
# VPS example: http://192.168.0.113:3000
BETTER_AUTH_URL="http://localhost:8080"
# Extra origins (comma-separated). Use * to also trust the browser Origin header (LAN/VPS).
BETTER_AUTH_TRUSTED_ORIGINS="*"


# Production Node bind (npm start / PM2). Defaults: 0.0.0.0:3000
# HOST=0.0.0.0
# PORT=3000
# NITRO_HOST=0.0.0.0
# NITRO_PORT=3000

# Build target is locked to node-server in vite.config.ts — do not use cloudflare/wrangler.
# NITRO_PRESET=node-server

# Cloudflare Turnstile — PAUSED (commented out in code).
# Do not set these until you are ready for production and ask to re-enable:
# VITE_TURNSTILE_ENABLED=true
# TURNSTILE_ENABLED=true
# TURNSTILE_SECRET_KEY="your-turnstile-secret"

# First admin bootstrap ONLY (npm run auth:seed-admin). Do NOT commit real values.
# Password must be 12+ characters. Remove these from .env after first login if you prefer.
# SEED_ADMIN_EMAIL="you@example.com"
# SEED_ADMIN_PASSWORD="choose-a-strong-unique-password"
# SEED_ADMIN_NAME="Administrator"
