# Local Postgres (required)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/medlearhub"

# Better Auth (required for admin login)
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
# Must match the exact URL you open in the browser (no trailing slash)
BETTER_AUTH_URL="http://localhost:8080"
# Optional: extra allowed origins, comma-separated
# BETTER_AUTH_TRUSTED_ORIGINS="http://192.168.0.113:3000,http://192.168.0.113:8080"

# Cloudflare Turnstile (paused on localhost/dev by default).
# When hosting, set both flags to true and add your secret:
# VITE_TURNSTILE_ENABLED=true
# TURNSTILE_ENABLED=true
# TURNSTILE_SECRET_KEY="your-turnstile-secret"
